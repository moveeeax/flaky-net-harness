<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fix verification — {{ .After.Target }} under {{ .Profile }}</title>
<style>
  :root {
    --bg: #ffffff; --fg: #14181d; --muted: #5c6773; --line: #e2e6ea;
    --crit: #b3261e; --high: #b25000; --med: #8a6d00; --info: #2f6f4f;
    --card: #f6f8fa;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14181d; --fg: #e8ecf1; --muted: #9aa7b4; --line: #2a3138;
      --crit: #ff6b5e; --high: #ffa04d; --med: #e3c14a; --info: #6fd39b;
      --card: #1c2228;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 2rem 1.25rem 4rem; background: var(--bg); color: var(--fg);
         font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  main { max-width: 62rem; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.15rem; margin: 2.25rem 0 .75rem; border-bottom: 1px solid var(--line); padding-bottom: .35rem; }
  .sub { color: var(--muted); margin: 0 0 1.5rem; }
  .verdict { display: inline-block; padding: .55rem .9rem; border-radius: .4rem; font-weight: 700;
             background: var(--card); border-left: 5px solid var(--info); }
  .verdict.regressed { border-left-color: var(--crit); color: var(--crit); }
  .verdict.partial, .verdict.unchanged-loss { border-left-color: var(--high); color: var(--high); }
  .warn { border: 1px solid var(--crit); border-radius: .5rem; padding: .75rem 1rem; margin: 1.25rem 0; }
  .warn li { color: var(--crit); }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .75rem; margin: 1.5rem 0; }
  .tile { background: var(--card); border: 1px solid var(--line); border-radius: .5rem; padding: .85rem 1rem; }
  .tile .n { font-size: 1.7rem; font-weight: 700; line-height: 1.1; }
  .tile .l { color: var(--muted); font-size: .82rem; }
  .tile.crit .n { color: var(--crit); }
  .tile.ok .n { color: var(--info); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .9rem; }
  th, td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; white-space: nowrap; }
  td.num, th.num { text-align: right; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .85em; }
  .tag { font-size: .74rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
  .chg-regressed, .chg-still_silent { color: var(--crit); }
  .chg-worsened { color: var(--high); }
  .chg-fixed, .chg-improved { color: var(--info); }
  .chg-unchanged, .chg-only_before, .chg-only_after { color: var(--muted); }
  footer { margin-top: 3rem; color: var(--muted); font-size: .82rem; border-top: 1px solid var(--line); padding-top: 1rem; }
</style>
</head>
<body>
<main>
  <h1>Fix verification — {{ .After.Target }}</h1>
  <p class="sub">compared with {{ .Before.Target }} under network profile <code>{{ .Profile }}</code> v{{ .ProfileVersion }}
     · fingerprint <code>{{ .Before.Fingerprint }}</code>{{ if not .FingerprintsMatch }} vs <code>{{ .After.Fingerprint }}</code>{{ end }}</p>

  <p class="verdict {{ verdictClass . }}">{{ .Summary }}</p>

  {{ with .Warnings }}
  <div class="warn">
    <strong>Caveats on this comparison</strong>
    <ul>{{ range . }}<li>{{ . }}</li>{{ end }}</ul>
  </div>
  {{ end }}

  <div class="tiles">
    <div class="tile ok"><div class="n">{{ changeCount .ChangeCounts "fixed" }}</div><div class="l">silent losses fixed</div></div>
    <div class="tile crit"><div class="n">{{ changeCount .ChangeCounts "regressed" }}</div><div class="l">new silent losses</div></div>
    <div class="tile crit"><div class="n">{{ changeCount .ChangeCounts "still_silent" }}</div><div class="l">still lost silently</div></div>
    <div class="tile"><div class="n">{{ .Before.SilentLosses }} → {{ .After.SilentLosses }}</div><div class="l">silent losses, before → after</div></div>
    <div class="tile"><div class="n">{{ bytes .After.SilentBytes }}</div><div class="l">lost silently in the after run</div></div>
  </div>

  <h2>The two runs</h2>
  <div class="scroll">
  <table>
    <thead><tr><th></th><th>Before</th><th>After</th></tr></thead>
    <tbody>
      <tr><td>Target</td><td>{{ .Before.Target }}</td><td>{{ .After.Target }}</td></tr>
      <tr><td>Run started</td><td>{{ .Before.StartedAt }}</td><td>{{ .After.StartedAt }}</td></tr>
      <tr><td>Profile fingerprint</td><td><code>{{ .Before.Fingerprint }}</code></td><td><code>{{ .After.Fingerprint }}</code></td></tr>
      <tr><td>Report verdict</td><td>{{ .Before.Verdict }}</td><td>{{ .After.Verdict }}</td></tr>
      <tr><td>Silently lost or corrupted</td><td>{{ .Before.SilentLosses }} ({{ bytes .Before.SilentBytes }})</td><td>{{ .After.SilentLosses }} ({{ bytes .After.SilentBytes }})</td></tr>
      <tr><td>Lost with an error shown</td><td>{{ .Before.ReportedLoss }}</td><td>{{ .After.ReportedLoss }}</td></tr>
      <tr><td>Stored twice</td><td>{{ .Before.Duplicated }}</td><td>{{ .After.Duplicated }}</td></tr>
      <tr><td>Delivered intact</td><td>{{ .Before.Delivered }}</td><td>{{ .After.Delivered }}</td></tr>
      <tr><td>Server state from</td><td>{{ .Before.ServerSource }}</td><td>{{ .After.ServerSource }}</td></tr>
    </tbody>
  </table>
  </div>

  <h2>Per object</h2>
  <div class="scroll">
  <table>
    <thead><tr>
      <th>Change</th><th>Object</th><th>Workflow</th><th>Before</th><th>After</th><th>Evidence</th>
    </tr></thead>
    <tbody>
    {{ range .Transitions }}
      <tr>
        <td class="tag chg-{{ printf "%s" .Change }}">{{ humanise (printf "%s" .Change) }}</td>
        <td><code>{{ .ObjectID }}</code>{{ if .Label }}<br><span class="l">{{ .Label }}</span>{{ end }}</td>
        <td>{{ humanise .Workflow }}</td>
        <td>{{ outcome .Before }}</td>
        <td>{{ outcome .After }}</td>
        <td>{{ .Evidence }}</td>
      </tr>
    {{ end }}
    </tbody>
  </table>
  </div>

  <footer>
    Generated by flaky-net-harness at {{ .GeneratedAt.Format "2006-01-02 15:04:05 UTC" }}.
    Objects are matched by id; an object missing from one run is shown as absent.
    Two runs are only comparable when the profile fingerprint matches.
  </footer>
</main>
</body>
</html>
